# Copy this file to .env and fill in your free-tier API keys.
# .env is gitignored - real keys must NEVER be committed.
#
# All keys are OPTIONAL. The pipeline runs fully offline by default (see
# SOC_OFFLINE below); a real lookup is only attempted for a source whose key is
# set. Get free keys here:
#   AbuseIPDB  -> https://www.abuseipdb.com/register  (free tier)
#   VirusTotal -> https://www.virustotal.com/gui/join-us  (free public API)

ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Force fully-offline mode (no network at all) even if keys are set.
# "1"/"true" = offline. Default when unset is offline-first: a source is only
# queried live when its key is present AND SOC_OFFLINE is not truthy.
SOC_OFFLINE=1

# Where to cache enrichment results (default: .cache/)
# SOC_CACHE_DIR=.cache
